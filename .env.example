# Copy to .env for local development. NEVER commit .env files.
# Use separate values (and separate Supabase projects) for development, staging, production.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase project (Settings > API). The service role key BYPASSES RLS: server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Supabase: Settings > Database > Connection pooling)
DATABASE_URL=

REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins, e.g. http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Public URL of the React app (used as the redirect target in invitation / verification emails)
FRONTEND_URL=http://localhost:5173
